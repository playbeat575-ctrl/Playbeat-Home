# ─────────────────────────────────────────────────────────────
# PlayBeat Digital — environment variables (copy to .env)
# ─────────────────────────────────────────────────────────────

# Database — PostgreSQL (Neon) connection string.
# Get yours from https://console.neon.tech
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

# ── Lemon Squeezy (official API) ──────────────────────────────
# Create an API key: https://app.lemonsqueezy.com/settings/api
LEMON_API_KEY=""

# Store ID (UUID) from your Lemon Squeezy dashboard URL.
LEMON_STORE_ID=""

# Default variant ID used for hosted checkouts when a product has no
# per-product variant mapping. Create a "pay-what-you-want" or standard
# variant in Lemon Squeezy and paste its numeric ID here to enable live
# checkouts. When empty, the storefront runs in demo checkout mode.
LEMON_DEFAULT_VARIANT_ID=""

# Webhook signing secret (Lemon Squeezy > Settings > Webhooks).
# Used by /api/lemon/webhook to verify incoming event signatures.
LEMON_WEBHOOK_SECRET=""

# Set to "true" to force the in-app demo checkout even when Lemon Squeezy
# is fully configured. Useful for local testing.
LEMON_DEMO_MODE="false"
